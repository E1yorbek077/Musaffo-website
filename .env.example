# Every setting the site reads. Copy to .env.local for local use; on Netlify set them under
# Site configuration → Environment variables. Never put real values in this file.

# PUBLIC. The site's own address, e.g. https://musaffo-xorazm.uz (no trailing slash). Optional on Netlify, which sets URL itself.
NEXT_PUBLIC_SITE_URL=

# SECRET. Token of the Telegram bot that sends each order to the manager (from @BotFather). Server-side only.
TELEGRAM_BOT_TOKEN=

# SECRET. Chat ID of the manager the bot sends orders to. Server-side only.
TELEGRAM_CHAT_ID=
