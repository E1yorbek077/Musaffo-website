# Copy to .env.local and fill in. Never commit real values.

# Address of the live site, used for canonical links, hreflang, the sitemap and social previews.
# Read during `npm run build`, so rebuild after changing it.
NEXT_PUBLIC_SITE_URL=https://www.musaffo.uz

# Telegram bot that sends orders to the manager. Server-side only: no NEXT_PUBLIC_ prefix, ever.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: where the order backup is written. Default: data/orders.jsonl in the project folder.
# ORDERS_FILE=/var/lib/musaffo/orders.jsonl
